# HeavyMP Server 1.0.0 - server configuration, Node.js >= 22.13.
# Copy to .env, set the Manager URL and owner SteamID64, then run npm start.
# Paths are relative to the heavymp/ directory.
# Restart after editing. Keep your .env private.

# === CONSOLE ===
# info: startup summary and incidents. debug: technical details.
# warn: warnings and errors only. error: errors only.
LOG_LEVEL=info
# ANSI colours for the terminal or panel. false: plain text. auto: interactive terminals only.
# Defaults to true even without a TTY because hosting panels often redirect output.
# Set NO_COLOR to any non-empty value to turn colours off.
LOG_COLORS=true
# Player join and leave events are debug-only by default.
LOG_PLAYER_EVENTS=false
# Identical errors are grouped after the first occurrence (10000..3600000 ms).
LOG_REPEAT_INTERVAL_MS=60000

# === INSTANCE ===
# Choose a stable ID and a public display name.
SERVER_ID=community
SERVER_NAME="HeavyMP Community Server"
# Optional local registry. A single instance needs no file.
# SERVERS_FILE=./data/servers.json

# === NETWORK AND ACCESS ===
# Put this listener behind a reverse proxy for public HTTPS and WebSocket access.
HOST=127.0.0.1
# Internal port. PORT takes precedence over the legacy SERVER_PORT.
PORT=30007
# For a public standalone instance, configure the address shown in /servers.
# PUBLIC_HOST=server.example.org
# PUBLIC_PORT=443
ROOM=YourServerName
# Optional: allow only local staff clients. Configure their fingerprints first.
# STAFF_IDENTITIES=
STAFF_ONLY=false
# Maximum concurrent connections (2..5000).
MAX_PLAYERS=2000

# === HVMP SERVER MANAGER ===
# Web panel on the same port: https://your-server/manager/
# true: the Manager remains available while its game process is stopped.
# false: start the game process directly without a web panel.
MANAGER_ENABLED=true
# On a full Manager restart, the game process stays stopped until you select Start.
# Reconnecting to the Manager does not start the game process.
# Set the public HTTPS origin for Steam login. HTTP is supported for local development.
# If you use your own domain, do not use PORT
MANAGER_PUBLIC_URL=http://127.0.0.1:30007
# SteamID64 allowlist for this instance (up to 100 accounts).
# By default, read data/manager-access.json: {"schema":1,"admins":["STEAMID64"]}
# Alternatively, set a comma-separated list. An explicitly empty variable also overrides the file.
# No accounts are allowed by default.
# MANAGER_ADMIN_STEAM_IDS=
# Graceful shutdown timeout before terminating the game process (1000..30000 ms).
MANAGER_STOP_TIMEOUT_MS=10000

# === DATA AND ADD-ONS ===
# Keep this directory to preserve contacts, phone data, pending missions and shared world time.
DATA_DIR=./data
LOG_DIR=./logs
# The server verifies .scs archives on startup and distributes them to clients.
# data/addons.json is generated automatically and caches file hashes.
# The index is updated when an archive is added, removed or changed.
# A legacy addons/manifest.json is imported once for its metadata.
ADDONS_DIR=./addons
# Map module stem, such as idf for map/idf.mbd. The default is europe.
# Use a separate ETS2 career for a standalone module.
# MAP_MODULE=idf
# Optional explicit manifest. Set to none to disable add-ons:
# MAP_MANIFEST=./addons/manifest.json
# MAP_MANIFEST=none
# Optional depot definitions for the /move command.
# DEPOTS_FILE=./data/depots.json

# === SYNCHRONIZATION AND BUDGETS ===
# Maximum nearby player vehicles shown on each client.
MAX_NEARBY_PLAYERS=32
# Distances in metres, network rates in Hz and intervals in milliseconds.
SYNC_RADIUS=1000
TICK_HZ=20
GRID_CELL_SIZE=250
INTEREST_INTERVAL_MS=200
INTEREST_CANDIDATE_BUDGET=512
# Maximum vehicle configuration cache size in MiB.
MAX_CONFIG_MB=512

# === PHYSICS AND ZONES ===
PLAYER_COLLISIONS=true
NO_COLLISION_ZONES_ENABLED=true
# The zone catalogue must match the active add-ons. Regenerate it after changing the map:
# node server/scripts/generate-ncz.mjs --game-dir ... --manifest data/addons.json
# NO_COLLISION_ZONES_FILE=./data/no-collision-zones.json

# === WORLD AND CHAT ===
# In-game minutes per real minute (1 to 60). Weather: dynamic, clear, rain.
TIME_SCALE=19
WEATHER=dynamic
LOCAL_CHAT_RADIUS=500
GLOBAL_CHAT_RATE=6

# === CROSS-SERVER PHONE (OPTIONAL) ===
# Without a shared relay, calls and texts stay within this server.
# Set a private key for your own shared phone relay.
# Set a relay key per server in the shared hub's PHONE_HUB_KEYS.
# PHONE_HUB_URL=wss://phone.example.com/phone-hub
# PHONE_HUB_KEY=REPLACE_WITH_YOUR_PRIVATE_RELAY_KEY
# Use JSON in single quotes. TURN is recommended on restrictive networks.
# PHONE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turns:turn.example.com:443","username":"players","credential":"REPLACE_ME"}]'
# Run the shared hub separately: node server/system/phone-hub-main.mjs

# === NATIVE ETS2 AI TRAFFIC (TEST) ===
# ETS2 simulates native AI. HeavyMP coordinates the simulator for each nearby player group.
# This uses the game's roads and driving behaviour.
# Players need a client compatible with traffic protocol 6.
TRAFFIC_ENABLED=false
# Target number of powered vehicles per simulator (positive integer).
# Examples: 32, 64, 128. The setting has no 8, 16 or 32 vehicle cap.
# Trailers count as additional bodies, up to three per vehicle.
TRAFFIC_MAX_VEHICLES=32
# Broadcast distance in metres (100..1500). Current spacing between sources: 2*radius+200m.
TRAFFIC_VIEW_RADIUS=750
# Maximum updates per second (2..10).
TRAFFIC_HZ=10
# Total budget (positive integer). It limits the number of groups for the target population.
TRAFFIC_GLOBAL_MAX_VEHICLES=128

# === AI SOURCE STABILITY (SERVER ONLY, MILLISECONDS) ===
# Allow a brief availability change before switching sources (0..1500).
TRAFFIC_SOURCE_GRACE_MS=750
# Replace a connected source that stops publishing valid snapshots (1500..15000).
TRAFFIC_SOURCE_TIMEOUT_MS=3000
# Initial warm-up for native models before marking the source inactive (3000..60000).
TRAFFIC_SOURCE_WARMUP_MS=15000
# A timed-out source is temporarily skipped so another player can take over.

# === SECTOR SCHEDULING (USES GRID_CELL_SIZE) ===
# Adjust update rates and interest by sector. false uses global scheduling.
SECTOR_SCHEDULING=true
# Target average work per sector per pass in milliseconds (0.25..25).
# Work already in progress can finish after the budget is reached.
SECTOR_WORK_BUDGET_MS=4
